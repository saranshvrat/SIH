# CPU worker: downloads, preprocessing, previews, metrics, reports, cleanup.
# No torch here — it would add ~2.5 GB for nothing.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      libexpat1 libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/ ./requirements/
RUN pip install -r requirements/base.txt && \
    pip install -r requirements/reports.txt || \
    echo "WeasyPrint unavailable; report endpoint will return JSON and say so."

COPY app/ ./app/
RUN useradd -m -u 1000 pixelforge && chown -R pixelforge /app
USER pixelforge

CMD ["celery", "-A", "app.tasks.celery_app", "worker", \
     "-Q", "cpu", "--concurrency", "4", "-l", "info"]
