# ==========================================================================
# PixelForge — environment configuration
#
#   cp .env.example .env
#
# The application RUNS WITH NO EDITS at all: it falls back to SQLite, local
# filesystem storage, in-process jobs, and the bicubic baseline model.
# Each section below says what it unlocks.
# ==========================================================================

# --- core ----------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# REQUIRED IN PRODUCTION. Signs local download URLs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# --- database ------------------------------------------------------------
# Default: zero-setup SQLite. Docker compose overrides this with PostGIS.
DATABASE_URL=sqlite:///./pixelforge.db
# DATABASE_URL=postgresql+psycopg://pixelforge:pixelforge@localhost:5432/pixelforge

# --- async processing ----------------------------------------------------
# With Redis reachable, jobs run on Celery workers. Without it, they run
# in-process in a background thread — fine for a laptop, not for production.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- object storage ------------------------------------------------------
# local = a directory on disk (no services needed).  s3 = MinIO / AWS / R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_SCENES=pixelforge-scenes
S3_BUCKET_JOBS=pixelforge-jobs
S3_BUCKET_REPORTS=pixelforge-reports
S3_PRESIGN_TTL=900

# --- ephemeral data model ------------------------------------------------
# PixelForge keeps no permanent user data. These control how long anything
# survives before the cleanup task deletes it (rows AND stored objects).
SESSION_COOKIE_NAME=pf_session
SESSION_TTL_HOURS=12
JOB_TTL_HOURS=24
SCENE_CACHE_TTL_HOURS=72
CLEANUP_INTERVAL_MINUTES=15

# --- machine learning ----------------------------------------------------
# UNLOCKS: the SEN2SR model. Without this only the bicubic baseline runs.
# Point ML_REPO_PATH at a checkout of the PixelForge ML repository, then run
#   cd backend && python scripts/smoke_adapter.py --model sen2sr --input <patch.tif> --out ./out
# See docs/ML-INTEGRATION.md before trusting the result.
ML_REPO_PATH=./ml
ML_WEIGHTS_PATH=./ml/experiments/models
ML_COMMIT=unknown                # record the ML repo commit for provenance
ML_DEVICE=cuda                   # cuda | cpu
ML_DEFAULT_MODEL=bicubic
ML_KEEP_MODELS_RESIDENT=true

# ONNX weight-file models (WSX4-SPATRAD and similar). These ship as a
# self-contained .onnx file + YAML sidecar from the model author — no
# separate code repository needed, unlike ML_REPO_PATH above.
# UNLOCKS: wsx4_spatrad and wsx4_spatrad_mumbai_ft.
# Put the .onnx files in this directory (filenames must match
# model_catalog.yaml's `weights_filename` for each model).
ONNX_WEIGHTS_DIR=./ml_weights

# --- Copernicus Data Space (satellite imagery) ---------------------------
# NOT USED ANY MORE: the Explore page's Sentinel-2 search now goes straight to
# Microsoft Planetary Computer's public STAC catalogue (see
# app/services/catalog/planetary_computer.py), which needs no account, no client, and
# no secret. These two are left here, unused, only in case you want to switch back to
# CDSE (app/services/catalog/cdse.py) -- fill them in and re-point routes/scenes.py and
# domains/pipeline.py at it if so. Register free at https://dataspace.copernicus.eu/ then
# create an OAuth client under your account settings.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- AI analyst (optional) ----------------------------------------------
# UNLOCKS: written explanations in the analyst panel. Without a key the
# analyst still works and still calls real backend tools — it just returns a
# direct data readout instead of prose. The app never crashes for lack of a key.
LLM_PROVIDER=none                # anthropic | openai | none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# --- limits --------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_AOI_KM2=25
MAX_INPUT_PX=512
JOB_SOFT_TIME_LIMIT=1500
JOB_TIME_LIMIT=1800
